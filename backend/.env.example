\# Gemini API key — get a free one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

\# Supabase — get these from your Supabase project settings > API
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

\# Allowed frontend origin (for CORS) — update when you deploy
FRONTEND_ORIGIN=http://localhost:5173

\# Optional — Sentry free tier for error tracking (leave blank to disable)
\# Sign up free at https://sentry.io, create a Python/FastAPI project, paste its DSN here
SENTRY_DSN=

\# Optional — Phase 0 hardening knobs, all have sane defaults if left unset
MAX_UPLOAD_MB=15
MAX_AUDIO_MB=20
DAILY_GENERATION_LIMIT=5
